# Which runtime serves the pages: the bundled micro kernel (default, no
# dependencies) or Laravel itself once `composer install` has been run.
APP_NAME="Fitzroy Travel"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Photography. Point this at your own CDN, or leave it on the live site while
# using the clone as a design study. Download the files into public/img and set
# ASSET_BASE=/img (img() treats any path starting with /img/ as local).
ASSET_BASE=https://fitzroy-travel.com/wp-content

# Compile Blade templates into storage/framework/views (1 = on).
VIEW_CACHE=0
