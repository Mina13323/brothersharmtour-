# ── Site Configuration ────────────────────────────────────────────────
# Canonical URL of your live website on Hostinger (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://brothersharmtour.com

# ── Supabase Database & Persistence (Optional but Recommended) ─────────
# When configured, CMS edits and bookings are synchronized with Supabase Postgres.
# This ensures content persists across server redeployments or container restarts.
# Run supabase/schema.sql in your Supabase SQL Editor to initialize the database tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# REQUIRED for review moderation to persist: the reviews table only exposes
# APPROVED rows to the public role, so privileged CMS writes (approve/reject/
# verify/delete) must use the service role key. Keep it secret — never expose it
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Contact Information ───────────────────────────────────────────────
# WhatsApp number in international format without '+' or spaces (e.g. 201012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=201042441923
NEXT_PUBLIC_PHONE=+20 10 4244 1923
NEXT_PUBLIC_EMAIL=contact@brothersharmtour.com

# ── CMS Admin Authentication & Security ──────────────────────────────
# Admin credentials used for logging into /admin/login
ADMIN_EMAIL=admin@brothersharmtour.com
ADMIN_PASSWORD=Admin@Sitemanagment@26!

# Secret key used for signing HMAC admin session tokens
# You can generate a custom 64-char key or use this default
AUTH_SECRET=9f8c321d4a6e8b7c5f2a1e0d3c4b5a697812e4f0a9b8c7d6e5f4a3b2c1d0e9f8

# ── Hostinger SMTP Email Configuration ───────────────────────────────
# Used to send customer booking confirmations and notify team of new inquiries
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@brothersharmtour.com
SMTP_PASS=YourHostingerEmailPasswordHere
SMTP_SECURE=true
SMTP_FROM_NAME="Brother Sharm Tour"
EMAIL_FROM=contact@brothersharmtour.com
