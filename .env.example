# ── Site ─────────────────────────────────────────────────────────────
# Canonical URL — used in sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://brothersharmtour.com

# ── CMS admin bootstrap ──────────────────────────────────────────────
# The admin account is seeded on first boot; override BEFORE the first run
# in production. Change the password from the CMS after signing in.
# ADMIN_EMAIL=admin@brothersharmtour.com
# ADMIN_PASSWORD=change-this-before-first-run

# ── Email (Hostinger SMTP) ───────────────────────────────────────────
# Credentials live ONLY here — never in the CMS, never in the client bundle.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=bookings@brothersharmtour.com
SMTP_PASS=
# Optional overrides
# SMTP_SECURE=true
# SMTP_FROM_NAME="Brother Sharm Tour"
# EMAIL_FROM=bookings@brothersharmtour.com
